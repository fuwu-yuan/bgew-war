rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['name', 'wins', 'losses', 'games', 'bestTime', 'needsName', 'createdAt', 'updatedAt'])
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.games == 0
        && request.resource.data.needsName == true;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['name', 'needsName', 'updatedAt'])
            && request.resource.data.wins == resource.data.wins
            && request.resource.data.losses == resource.data.losses
            && request.resource.data.games == resource.data.games
            && request.resource.data.needsName == false
          )
          ||
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['wins', 'losses', 'games', 'bestTime', 'updatedAt'])
            && request.resource.data.wins >= resource.data.wins
            && request.resource.data.wins <= resource.data.wins + 1
            && request.resource.data.losses >= resource.data.losses
            && request.resource.data.losses <= resource.data.losses + 1
            && request.resource.data.games == resource.data.games + 1
          )
        );
      allow delete: if false;

      match /matches/{matchId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.keys().hasOnly(['win', 'time', 'share', 'kills', 'losses', 'faction', 'createdAt'])
          && request.resource.data.win is bool
          && request.resource.data.time is int
          && request.resource.data.time > 0
          && request.resource.data.share is number
          && request.resource.data.share >= 0
          && request.resource.data.share <= 1
          && request.resource.data.kills is int
          && request.resource.data.losses is int
          && request.resource.data.faction in [1, 2];
        allow update, delete: if false;
      }
    }
  }
}
