{
  "name": "bgew-war",
  "version": "1.0.0",
  "description": "BGEW WAR — territorial tug-of-war auto-battler built with BGEW (Baguette Game Engine Web)",
  "scripts": {
    "sounds": "node tools/generate-sounds.mjs",
    "icons": "node tools/generate-icons.mjs",
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=esm --sourcemap",
    "typecheck": "tsc --noEmit",
    "serve": "serve -l 5050",
    "start": "npm run build && npm run serve",
    "test": "npm run build && node tools/smoke-test.mjs",
    "server": "node tools/server.mjs",
    "test:multi": "npm run build && node tools/multi-test.mjs"
  },
  "keywords": [
    "game",
    "bgew",
    "2d",
    "war",
    "auto-battler",
    "tug-of-war"
  ],
  "author": "Steve Cohen",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/node": "^24.2.0",
    "esbuild": "^0.25.8",
    "playwright-core": "^1.60.0",
    "serve": "^14.2.4",
    "typescript": "^5.9.2",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@fuwu-yuan/bgew": "^1.13.0",
    "firebase": "^12.14.0"
  }
}
